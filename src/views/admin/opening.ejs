<%- include("_top", { title: "Ouverture Concorde" }) %>
<div class="ahead"><h1 class="atitle">Soirée d'ouverture Concorde</h1><a class="btn sm line" href="/admin/ouverture.csv">Exporter (CSV)</a></div>
<div class="stats"><div class="stat"><b class="mono"><%= rows.length %></b><span>inscriptions</span></div><div class="stat"><b class="mono"><%= rows.reduce(function(a, r){ return a + r.persons; }, 0) %></b><span>personnes attendues</span></div></div>
<div class="rlist">
<% if (!rows.length) { %><div class="empty">Aucune inscription. Partagez la page Concorde (voir « QR codes »).</div><% } %>
<% rows.forEach(function(r){ %><div class="rrow"><div class="who"><b><%= r.name %> · <%= r.persons %> pers.</b><span class="mono"><%= r.email %></span></div><span class="small muted"><%= U.fmtDate(U.isoDate(new Date(+r.created_at)), "fr") %></span></div><% }) %>
</div>
<%- include("_bottom") %>
