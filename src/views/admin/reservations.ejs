<%- include("_top", { title: "Réservations" }) %>
<div class="ahead"><h1 class="atitle">Réservations</h1><a class="btn sm" href="#nouvelle">Ajouter une réservation téléphone</a></div>
<div class="stats">
  <div class="stat<%= pending ? " alert" : "" %>"><b class="mono"><%= pending %></b><span>à traiter</span></div>
  <div class="stat"><b class="mono"><%= todayCount %></b><span>réservations aujourd'hui</span></div>
  <div class="stat"><b class="mono"><%= covers %></b><span>couverts aujourd'hui</span></div>
  <% pubs.filter(function(p){ return p.status !== "soon" && (user.role === "owner" || p.id === user.pub_id); }).forEach(function(p){ var l = load[p.id + "soir"]; %>
  <div class="stat"><b class="mono"><%= l ? l.left + "/" + l.cap : "∞" %></b><span>places libres ce soir · <%= p.name %></span></div>
  <% }) %>
</div>
<form class="filters" method="get" action="/admin">
  <% if (user.role === "owner") { %><div class="field"><label for="f-pub">Pub</label><select id="f-pub" name="pub"><option value="">Tous</option><% pubs.forEach(function(p){ %><option value="<%= p.id %>"<%= f.pub === p.id ? " selected" : "" %>><%= p.name %></option><% }) %></select></div><% } %>
  <div class="field"><label for="f-status">Statut</label><select id="f-status" name="status"><option value="">Tous</option><% Object.keys(STATUS_FR).forEach(function(k){ %><option value="<%= k %>"<%= f.status === k ? " selected" : "" %>><%= STATUS_FR[k] %></option><% }) %></select></div>
  <div class="field"><label for="f-when">Période</label><select id="f-when" name="when"><% [["upcoming","À venir"],["today","Aujourd'hui"],["past","Passées"],["all","Tout"]].forEach(function(o){ %><option value="<%= o[0] %>"<%= f.when === o[0] ? " selected" : "" %>><%= o[1] %></option><% }) %></select></div>
  <button class="btn sm line" type="submit">Filtrer</button>
</form>
<div class="rlist">
<% if (!rows.length) { %><div class="empty">Aucune réservation pour ces filtres.</div><% } %>
<% var labels = { confirmed: "Confirmer", declined: "Refuser", done: "Venu", noshow: "Absent", pending: "Remettre à traiter", cancelled: "Annuler" };
   var cls = { confirmed: "", declined: "danger", done: "ok", noshow: "line", pending: "line", cancelled: "danger" };
   rows.forEach(function(r){ var p = pubs.find(function(x){ return x.id === r.pub_id; }) || {}; %>
  <article class="ritem <%= r.status %>">
    <div class="when"><b><%= r.time %></b><%= U.fmtDate(r.date, "fr") %><% if (r.date === today) { %><span class="pill pending">auj.</span><% } %></div>
    <div class="who"><b><%= r.name %> · <%= r.persons %> pers.</b>
      <span><%= p.name %> · <%= r.occasion %> · <a class="mono" href="tel:<%= r.phone %>"><%= r.phone %></a><%= r.email ? " · " + r.email : "" %><%= r.lang === "en" ? " · EN" : "" %></span>
      <% if (r.note) { %><span class="note">« <%= r.note %> »</span><% } %></div>
    <div class="acts"><span class="pill <%= r.status %>"><%= STATUS_FR[r.status] %></span>
      <% (NEXT[r.status] || []).filter(function(s){ return (s !== "done" && s !== "noshow") || r.date <= today; }).forEach(function(s){ %>
      <form method="post" action="/admin/reservations/<%= r.id %>/status"<%= s === "declined" || s === "cancelled" ? ' data-confirm="Confirmer ?"' : "" %>><%- include("_csrf") %><input type="hidden" name="status" value="<%= s %>"><button class="btn sm <%= cls[s] %>" type="submit"><%= labels[s] %></button></form>
      <% }) %>
    </div>
  </article>
<% }) %>
</div>

<h2 class="asub" id="nouvelle">Ajouter une réservation prise par téléphone</h2>
<form class="card" method="post" action="/admin/reservations/new">
  <%- include("_csrf") %>
  <div class="grid3">
    <div class="field"><label for="n-pub">Pub</label><select id="n-pub" name="pub"><% pubs.filter(function(p){ return p.status !== "soon" && (user.role === "owner" || p.id === user.pub_id); }).forEach(function(p){ %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></div>
    <div class="field"><label for="n-date">Date</label><input type="date" id="n-date" name="date" value="<%= today %>" required></div>
    <div class="field"><label for="n-time">Heure</label><input type="time" id="n-time" name="time" value="19:30" required></div>
  </div>
  <div class="grid3">
    <div class="field"><label for="n-pers">Personnes</label><input type="number" id="n-pers" name="persons" min="1" max="200" value="2" required></div>
    <div class="field"><label for="n-name">Nom</label><input type="text" id="n-name" name="name" maxlength="120" required></div>
    <div class="field"><label for="n-tel">Téléphone</label><input type="tel" id="n-tel" name="phone" maxlength="32"></div>
  </div>
  <div class="field"><label for="n-note">Note</label><input type="text" id="n-note" name="note" maxlength="500"></div>
  <label class="ck"><input type="checkbox" name="force" value="1"> Dépasser la capacité si le service est complet</label>
  <button class="btn" type="submit">Ajouter (confirmée)</button>
</form>
<%- include("_bottom") %>
