<!doctype html>
<html lang="<%= lang %>">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex">
<title>Écran · Pub Goudale</title><link rel="stylesheet" href="/static/css/site.css?v=<%= v %>"><link rel="icon" href="/static/img/icon.svg"></head>
<body>
<div class="screen" id="screen" data-pub="<%= pubId %>" data-lang="<%= lang %>">
  <div class="sh"><span class="logo">GOUDALE <small id="sPub"><%= lang === "en" ? "GENEVA" : "GENÈVE" %></small></span><span class="clock" id="sClock">--:--</span></div>
  <div class="slide" id="sSlide"><h2>Pub Goudale</h2></div>
  <div class="sf"><div class="dots" id="sDots"></div><span class="mono small"><%= siteUrl.replace(/^https?:\/\//, "") %></span></div>
</div>
<script src="/static/js/screen.js?v=<%= v %>" defer></script>
</body></html>
