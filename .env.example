# ─────────────────────────────────────────────────────────────
#  Pub Goudale Genève — configuration du serveur
#  Copiez ce fichier en « .env » et remplissez les valeurs.
#  Ne partagez JAMAIS le fichier .env (il contient des mots de passe).
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000
# Adresse publique du site, en https
SITE_URL=https://www.pubgoudale.ch
# Nombre de proxys devant l'application (1 chez Infomaniak)
TRUST_PROXY=1

# Secret de 64 caractères. Générez-le avec : openssl rand -hex 32
APP_SECRET=

# Base de données MariaDB (Manager Infomaniak › Hébergement › Bases de données)
DB_CLIENT=mysql2
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# E-mails (adresse créée dans Infomaniak Mail, ex. noreply@pubgoudale.ch)
MAIL_MODE=smtp
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@pubgoudale.ch
SMTP_PASSWORD=
MAIL_FROM=Pub Goudale Genève <noreply@pubgoudale.ch>

# SMS : twilio (envoi réel), log (test, rien n'est envoyé) ou off
SMS_MODE=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro ou nom d'expéditeur Twilio, ex. +41... ou GOUDALE
TWILIO_FROM=

# Sécurité
ADMIN_REQUIRE_2FA=true
# Durée de conservation des réservations avant anonymisation (mois)
RETENTION_MONTHS=12

JOBS_ENABLED=true
TZ=Europe/Zurich
UPLOAD_DIR=./uploads
